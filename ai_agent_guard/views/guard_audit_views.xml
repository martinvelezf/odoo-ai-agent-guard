<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_guard_audit_log_form" model="ir.ui.view">
        <field name="name">guard.audit.log.form</field>
        <field name="model">guard.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit log">
                <header>
                    <button name="action_import" type="object"
                            string="Import &amp; verify" class="btn-primary"/>
                    <button name="action_verify" type="object"
                            string="Re-verify chain" class="btn-secondary"/>
                    <field name="chain_state" widget="statusbar"
                           statusbar_visible="unknown,ok,broken"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="log_file" filename="log_filename"/>
                            <field name="log_filename" invisible="1"/>
                            <field name="entry_count"/>
                        </group>
                        <group>
                            <field name="chain_message" readonly="1"/>
                            <field name="chain_head" readonly="1"/>
                        </group>
                    </group>
                    <field name="entry_ids">
                        <list decoration-danger="not valid" decoration-info="genesis">
                            <field name="line_no"/>
                            <field name="event"/>
                            <field name="agent"/>
                            <field name="model_name"/>
                            <field name="op"/>
                            <field name="hash"/>
                            <field name="valid"/>
                            <field name="genesis" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_guard_audit_log_list" model="ir.ui.view">
        <field name="name">guard.audit.log.list</field>
        <field name="model">guard.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit logs" decoration-danger="chain_state == 'broken'"
                  decoration-success="chain_state == 'ok'">
                <field name="name"/>
                <field name="entry_count"/>
                <field name="chain_state"/>
                <field name="chain_message"/>
            </list>
        </field>
    </record>

    <record id="action_guard_audit_log" model="ir.actions.act_window">
        <field name="name">Audit logs</field>
        <field name="res_model">guard.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
